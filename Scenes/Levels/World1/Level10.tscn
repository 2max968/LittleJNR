[sub_resource type="Shader" id=41]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec2 block_count;
uniform vec2 rect_size;
uniform sampler2D noice;
uniform vec4 color1: hint_color;
uniform vec4 color2: hint_color;
uniform vec4 color3: hint_color;

void fragment()
{
	vec2 uv = UV * rect_size / 128.0;
	float v1 = texture(noice, uv + TIME * vec2(0.03,0.01)).r;
	float v2 = texture(noice, uv + TIME * vec2(-0.04,-0.02)).r;
	float v = min(v1, v2);
	
	v += uv.y * 3.0;
	if(v > 2.0)
	{
		COLOR = color3;
	}
	else if(v > 1.0)
	{
		COLOR = mix(color2, color3, v - 1.0);
	}
	else
	{
		COLOR = mix(color1, color2, v);
	}
	
	if(uv.y < 0.02 + v / 20.0)
	{
		COLOR = vec4(1.0, 1.0, 1.0, 1.0);
	}
}"

